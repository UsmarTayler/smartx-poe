{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Attachments": {
    "StoragePath": "App_Data/attachments",
    "MaxFileBytes": 104857600
  },
  "Commands": {
    "PendingTimeout": "00:00:30",
    "DeliveredTimeout": "00:00:30",
    "SweepInterval": "00:00:01",
    "MaxUndoDepth": 20
  },
  "History": {
    "Store": "Avl",
    "RetentionWindow": "24:00:00",
    "EvictionInterval": "00:01:00",
    "DefaultTimelineWindow": "01:00:00",
    "DefaultMaxPoints": 200,
    "MaxPointsLimit": 2000,
    "DefaultEventLimit": 500,
    "MaxEventLimit": 5000
  },
  "Topology": {
    "ReportInterval": "00:00:30",
    "StaleAfterIntervals": 3,
    "PenaltyFactor": 4,
    "SnapshotMaxAge": "00:00:02",
    "MaxNeighbours": 16
  },
  "Alerts": {
    "DisconnectedAfterIntervals": 3,
    "ClearAfterValidReadings": 3
  },
  "Realtime": {
    "FlushInterval": "00:00:00.250",
    "PipelineInterval": "00:00:01",
    "MaxBufferedReadings": 10000,
    "TrustScoreEpsilon": 0.005,
    "RecentPriorityAlerts": 20,
    "SnapshotCommands": 100,
    "MaxQueuedMessages": 20000
  },
  "Zones": {
    "Hierarchy": "Brief"
  },
  "Ingestion": {
    "MaxQueueDepth": 10000,
    "MaxCriticalQueueDepth": 1000,
    "MaxConsecutiveCritical": 20,
    "RetryAfterSeconds": 5
  },
  "Telemetry": {
    "RetentionPerNode": 256
  },
  "Trust": {
    "SuccessWeight": 1,
    "RangeViolationWeight": 1,
    "SchemaFailureWeight": 2,
    "MissedHeartbeatWeight": 3,
    "HalfLife": "00:10:00",
    "OutcomeWindow": 256,
    "HistoryLength": 120,
    "HistorySampleInterval": "00:00:10",
    "SnapshotHistoryPoints": 30,
    "NominalThreshold": 0.75,
    "FaultThreshold": 0.5,
    "DefaultHeartbeatInterval": "00:01:00",
    "HeartbeatCheckInterval": "00:00:05"
  }
}
