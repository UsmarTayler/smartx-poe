{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Attachments": {
    "StoragePath": "App_Data/attachments",
    "MaxFileBytes": 104857600
  },
  "Simulation": {
    "Enabled": false,
    "BackfillDuration": "00:20:00",
    "TickInterval": "00:00:00.5",
    "RandomSeed": 1729
  },
  "Telemetry": {
    "RetentionPerNode": 256
  },
  "Trust": {
    "SuccessWeight": 1,
    "RangeViolationWeight": 1,
    "SchemaFailureWeight": 2,
    "MissedHeartbeatWeight": 3,
    "HalfLife": "00:10:00",
    "OutcomeWindow": 256,
    "HistoryLength": 120,
    "HistorySampleInterval": "00:00:10",
    "SnapshotHistoryPoints": 30,
    "NominalThreshold": 0.75,
    "FaultThreshold": 0.5,
    "DefaultHeartbeatInterval": "00:01:00",
    "HeartbeatCheckInterval": "00:00:05"
  }
}
