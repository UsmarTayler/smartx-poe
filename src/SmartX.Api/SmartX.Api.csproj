<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <InternalsVisibleTo Include="SmartX.Tests" />
    <ProjectReference Include="..\SmartX.Shared\SmartX.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Identifies this project's user-secrets store, where a development encryption key lives outside
         the repository. The id is not itself a secret. -->
    <UserSecretsId>smartx-api-attachments</UserSecretsId>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
