@inherits LayoutComponentBase

@* MudBlazor's providers must appear exactly once, above the layout. Dialogs, popovers and
   snackbars are rendered into these hosts rather than where they are invoked, so leaving one
   out makes the corresponding feature fail silently later on. *@
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIcon Icon="@Icons.Material.Filled.Hub" Class="mr-3" />
        <MudText Typo="Typo.h6">Smart-X</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="d-none d-sm-flex">
            IoT telemetry ingestion and mesh management
        </MudText>
    </MudAppBar>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>
