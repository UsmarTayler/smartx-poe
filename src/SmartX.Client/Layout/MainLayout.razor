@inherits LayoutComponentBase
@implements IDisposable
@inject AppState State
@inject ApiConnection Connection
@inject RealtimeConnection Realtime
@inject AuthSession Auth
@inject NavigationManager Navigation

@* MudBlazor's providers must appear exactly once, above the layout. Dialogs, popovers and
   snackbars are rendered into these hosts rather than where they are invoked, so leaving one
   out makes the corresponding feature fail silently later on. *@
<MudThemeProvider @ref="_themeProvider" Theme="SmartXTheme.Theme" IsDarkMode="IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0">
        @* Navigation exists for someone who is signed in. On the login page there is nowhere to go, and a menu of links that each
           bounce back to login is worse than no menu. *@
        @if (Auth.IsAuthenticated)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="ToggleDrawer"
                           aria-label="Toggle navigation"
                           aria-expanded="@(State.DrawerOpen ? "true" : "false")" />
        }

        <MudIcon Icon="@Icons.Material.Filled.Hub" Class="ml-1 mr-2" aria-hidden="true" />
        <MudText Typo="Typo.h6" HtmlTag="span">Smart-X</MudText>

        <MudSpacer />

        <ConnectionIndicator Display="ConnectionDisplays.From(Connection.Status, Realtime.State)" Transport="@Realtime.Transport" OnRetry="RetryConnectionAsync" />

        @* Who is signed in, and as what, in words: the role is what decides whether the controls on the page are enabled, so it is
           always in view. *@
        @if (Auth.User is { } user)
        {
            <MudText Typo="Typo.body2" Color="Color.Inherit" Class="smartx-appbar-user mx-3" role="status">
                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" aria-hidden="true" />
                <span class="smartx-appbar-user__name">@user.Username</span>
                <span class="smartx-appbar-user__role">@user.Role</span>
            </MudText>
            <MudButton Color="Color.Inherit" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Logout"
                       OnClick="SignOutAsync" Class="mr-2">Log out</MudButton>
        }

        <MudTooltip Text="@ThemeToggleLabel">
            <MudIconButton Icon="@(IsDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           Edge="Edge.End"
                           OnClick="ToggleTheme"
                           aria-label="@ThemeToggleLabel" />
        </MudTooltip>
    </MudAppBar>

    @* Inert while closed, so keyboard focus cannot wander into navigation that is off screen: without
       it, Tab on a phone walks through four invisible links before reaching the page.
       Responsive: pinned open beside the content on wide screens, and an overlay that closes after
       use below the medium breakpoint, so a phone never loses two thirds of its width to navigation. *@
    @if (Auth.IsAuthenticated)
    {
        <MudDrawer Open="State.DrawerOpen"
                   OpenChanged="State.SetDrawerOpen"
                   ClipMode="DrawerClipMode.Always"
                   Variant="DrawerVariant.Responsive"
                   Breakpoint="Breakpoint.Md"
                   Elevation="0"
                   inert="@(!State.DrawerOpen)">
            <NavMenu />
        </MudDrawer>
    }

    @* MudMainContent renders a div, so the page's one main landmark is declared here. Without it a screen reader's "jump to main
       content" has nowhere to go, and every control on the page sits outside any landmark. *@
    <MudMainContent>
        <main>
            <MudContainer MaxWidth="MaxWidth.Large" Class="py-6 px-3 px-sm-6">
                @Body
            </MudContainer>
        </main>
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider? _themeProvider;

    private bool IsDark => State.IsDarkMode ?? false;

    private string ThemeToggleLabel => IsDark ? "Switch to light theme" : "Switch to dark theme";

    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        Connection.Changed += OnStateChanged;
        Realtime.StateChanged += OnStateChanged;
        Auth.Changed += OnSessionChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        // The stored session is read before anything else, because whether the hub may be opened depends on it.
        await Auth.RestoreAsync();
        StartRealtimeIfSignedIn();

        await Connection.CheckAsync();
    }

    // The one real-time connection starts with the app and not with any page, so the indicator is right on every page, and a page
    // opening or closing can never be what opens or closes the connection. It needs a token, so it starts once someone is signed in:
    // at load if a session was restored, and at the moment of login otherwise.
    private void StartRealtimeIfSignedIn()
    {
        if (Auth.IsAuthenticated)
        {
            Realtime.EnsureStarted();
        }
    }

    private void OnSessionChanged()
    {
        StartRealtimeIfSignedIn();
        _ = InvokeAsync(StateHasChanged);
    }

    // A reload and not a navigation, so nothing the previous user was looking at (feeds, the stream's buffer, the hub connection)
    // is left in memory for the next person to sign in.
    private async Task SignOutAsync()
    {
        await Auth.SignOutAsync();
        Navigation.NavigateTo("login", forceLoad: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The operating system's preference is a starting point, read once. After that the toggle
        // owns the choice, and because the choice lives in AppState it survives navigation.
        if (firstRender && State.IsDarkMode is null && _themeProvider is not null)
        {
            State.SetDarkMode(await _themeProvider.GetSystemDarkModeAsync());
        }
    }

    private void ToggleDrawer() => State.SetDrawerOpen(!State.DrawerOpen);

    private void ToggleTheme() => State.SetDarkMode(!IsDark);

    private Task RetryConnectionAsync() => Connection.CheckAsync();

    // Changes can be raised from a service's continuation rather than from this component's own
    // event handler, so the re-render is routed through InvokeAsync instead of StateHasChanged.
    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        Connection.Changed -= OnStateChanged;
        Realtime.StateChanged -= OnStateChanged;
        Auth.Changed -= OnSessionChanged;
    }
}
