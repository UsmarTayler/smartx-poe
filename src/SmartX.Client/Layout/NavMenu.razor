@* The three pillars of the brief, all built and all behaving the same way: each is a group that holds its pages.

   The active pillar is the one that holds the page being shown. Each pillar is a group, expanded while one of its pages is
   open, so the menu says where you are at the level of the product and not only of the page. *@
<MudNavMenu Class="py-2" Color="Color.Primary" Rounded="true" aria-label="Pillars and pages">
    <MudText Typo="Typo.overline" Class="px-4 mud-text-secondary">Pillars</MudText>

    <MudNavGroup Title="Sensor Data Ingestion and Telemetry"
                 Icon="@Icons.Material.Filled.Sensors"
                 Expanded="true">
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Shield">Trust panel</MudNavLink>
        <MudNavLink Href="sensors" Icon="@Icons.Material.Filled.AppRegistration">Sensors</MudNavLink>
        <MudNavLink Href="telemetry" Icon="@Icons.Material.Filled.Timeline">Telemetry</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Real-Time Command Stream and History"
                 Icon="@Icons.Material.Filled.Terminal"
                 Expanded="true">
        <MudNavLink Href="command-stream" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Podcasts">Command stream</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Network Topology and Mesh Routing"
                 Icon="@Icons.Material.Filled.Lan"
                 Expanded="true">
        <MudNavLink Href="topology" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Hub">Mesh topology</MudNavLink>
    </MudNavGroup>
</MudNavMenu>
