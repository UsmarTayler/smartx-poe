@inject NavigationManager Navigation

@* Shown by the router in place of a page the visitor may not see. It does not render anything: it sends them to the login page, and
   remembers where they were going so that signing in lands them there. The address is a path on this site, never a full URL. *@

@code {
    protected override void OnInitialized()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

        Navigation.NavigateTo(
            path.StartsWith("/login", StringComparison.OrdinalIgnoreCase) || path == "/"
                ? "login"
                : $"login?returnUrl={Uri.EscapeDataString(path)}",
            replace: true);
    }
}
