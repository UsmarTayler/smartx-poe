@* The landing page's map of the product: the three pillars of the brief, with what each does. All three are open, and each is
   introduced the same way. *@
<div class="smartx-pillars" role="list" aria-label="The three pillars of Smart-X">
    <MudPaper Outlined="true" Class="smartx-pillar pa-3" role="listitem">
        <MudText Typo="Typo.subtitle2" HtmlTag="h2">Sensor Data Ingestion and Telemetry</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Register sensors, send readings, watch trust.</MudText>
        <MudButton Href="" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Shield">Open trust panel</MudButton>
    </MudPaper>

    <MudPaper Outlined="true" Class="smartx-pillar pa-3" role="listitem">
        <MudText Typo="Typo.subtitle2" HtmlTag="h2">Real-Time Command Stream and History</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Live readings, queues, alerts, device commands and undo.</MudText>
        <MudButton Href="command-stream" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Podcasts">Open command stream</MudButton>
    </MudPaper>

    <MudPaper Outlined="true" Class="smartx-pillar pa-3" role="listitem">
        <MudText Typo="Typo.subtitle2" HtmlTag="h2">Network Topology and Mesh Routing</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">The mesh, its cheapest backbone, its weak points and how routes heal.</MudText>
        <MudButton Href="topology" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Hub">Open network topology</MudButton>
    </MudPaper>
</div>
