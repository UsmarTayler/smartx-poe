@* A full-size look at a deployment photo. Close with the button, Escape, or the backdrop. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Class="smartx-attachments__name">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <AuthenticatedImage Load="LoadSource" Alt="@Title" Class="smartx-preview-image" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="DownloadAsync" StartIcon="@Icons.Material.Filled.Download">Download</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>Fetches the picture, with the bearer token, and returns an address to show it from.</summary>
    [Parameter]
    public Func<Task<string?>> LoadSource { get; set; } = () => Task.FromResult<string?>(null);

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public Func<Task> OnDownload { get; set; } = () => Task.CompletedTask;

    private Task DownloadAsync() => OnDownload();

    private void Close() => Dialog.Close();
}
