@* Every page needs a signed-in user except the login page and the not-found page, which say so with [AllowAnonymous] and by carrying
   no attribute. AuthorizeRouteView does the checking, and what it shows a visitor who fails it is the redirect to login, with the
   address they wanted kept. *@
<CascadingAuthenticationState>
    <SessionWatcher />
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <MudProgressLinear Indeterminate="true" aria-label="Checking your sign-in" />
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
