@page "/not-found"
@layout MainLayout

<PageTitle>Not found — Smart-X</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 d-flex flex-column align-center">
    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="mb-4" />
    <MudText Typo="Typo.h5" GutterBottom="true">Page not found</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
        There is nothing at that address.
    </MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">Back to the dashboard</MudButton>
</MudContainer>
