# Settings for docker compose. Copy this file to .env, which is gitignored, then run:
#   docker compose up --build

# Base64-encoded 256-bit AES key that attachments are encrypted with.
#
# This is the published DEVELOPMENT key from the README. Anyone who can read this repository can decrypt
# attachments encrypted with it, and the API logs a warning when it sees it outside Development. It exists
# so a local demo keeps its attachments readable across restarts. For anything else, generate a key with
#   openssl rand -base64 32
# and put it in your own .env instead.
SMARTX_ATTACHMENT_KEY=jk8ISNL3b2INdPgIONnlaaf0nycILpHni4khrvGdBlg=

# Seed the 40-sensor demo mesh and run the telemetry simulator.
SMARTX_SIMULATION_ENABLED=false

# Host ports for the client (open this one in the browser) and the API.
SMARTX_CLIENT_PORT=8080
SMARTX_API_PORT=5266
