# Settings for docker compose. Copy this file to .env, which is gitignored, then run:
#   docker compose up --build

# Base64-encoded 256-bit AES key that attachments are encrypted with.
#
# This is the published DEVELOPMENT key from the README. Anyone who can read this repository can decrypt
# attachments encrypted with it, and the API logs a warning when it sees it outside Development. It exists
# so a local demo keeps its attachments readable across restarts. For anything else, generate a key with
#   openssl rand -base64 32
# and put it in your own .env instead.
SMARTX_ATTACHMENT_KEY=jk8ISNL3b2INdPgIONnlaaf0nycILpHni4khrvGdBlg=

# The device simulator runs as its own container and reports to the API over HTTP, like real hardware.
# How many of the 48 demo devices to run.
SMARTX_DEVICE_COUNT=48

# Demo: a spread of healthy, drifting, spiking, faulty, silent and critical devices.
# Nominal: every device starts healthy.
SMARTX_SCENARIO_MIX=Demo

# How much history the fleet posts on first start, so the dashboard is not empty.
SMARTX_BACKFILL=00:10:00

# Which zone hierarchy the API manages. Demo is the one the simulated fleet is deployed into.
SMARTX_ZONE_HIERARCHY=Demo

# The most readings the standard ingestion queue holds before the API answers 503.
SMARTX_QUEUE_DEPTH=10000

# How many times faster than normal the fleet reports (1 is the devices' own cadence), and how often the simulator
# wakes to send what is due. Raise the rate to see how the Command Stream page behaves under load; lower the tick
# alongside it, because a rate above about 5 needs a shorter tick to be spread evenly.
SMARTX_RATE=1
SMARTX_TICK=00:00:00.500

# Simulates the per-reading processing cost of a resource-constrained gateway: how long the API worker pauses after each
# reading. Zero is an unconstrained gateway. A few milliseconds models a small board, and with SMARTX_RATE=50 the standard
# lane then backs up and the Command Stream page shows a critical reading jumping it. (Ingestion:SimulatedGatewayCost.)
SMARTX_PROCESS_DELAY=00:00:00

# Pattern analysis. How soon after a trigger (a reading crossing a watch level, an alert, a node falling into Degrading or
# Fault) an operator's action counts as a response to it, and how long until a learned habit counts half as much. Both are
# Patterns:Window and Patterns:HalfLife. A short window, such as 00:01:00, lets the example in the README be shown in minutes.
SMARTX_PATTERN_WINDOW=00:10:00
SMARTX_PATTERN_HALFLIFE=7.00:00:00

# Host ports for the client (open this one in the browser) and the API.
SMARTX_CLIENT_PORT=8080
SMARTX_API_PORT=5266
